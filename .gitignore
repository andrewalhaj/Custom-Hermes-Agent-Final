# Allow-list (CONTRIBUTING.md section 8): everything is ignored unless a line below allows it.
# A new directory or file type needs a line here first, or git will not show it.
# tests/test_gitignore.py proves both directions.

/*
!/.gitignore
!/.github/
!/ARCHITECTURE.md
!/CONTRIBUTING.md
!/OPERATIONS.md
!/pyproject.toml
!/hermes-requirements.txt
!/tests/
!/migrations/
!/custom_build/
!/.githooks/

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml

/tests/*
!/tests/*.py

/migrations/*
!/migrations/*.sql

/custom_build/*
!/custom_build/*.py
!/custom_build/plugin.yaml

/.githooks/*
!/.githooks/pre-commit

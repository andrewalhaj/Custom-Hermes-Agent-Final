#!/bin/sh
# Refuse a commit that carries a secret (CONTRIBUTING.md sections 4.4 and 8, rule W13).
# Fails closed: without gitleaks, or when gitleaks reports an error, nothing is committed.
command -v gitleaks >/dev/null 2>&1 || {
    echo "pre-commit: gitleaks is not installed, so nothing was scanned; see CONTRIBUTING.md 4.4" >&2
    exit 1
}
errors=$(mktemp) || exit 1
# Findings, redacted, go to stdout; at this log level only gitleaks's errors go to stderr.
gitleaks git --pre-commit --staged --redact --no-banner -v --log-level error --exit-code 1 2>"$errors"
code=$?
if [ -s "$errors" ]; then
    # gitleaks exits 0 when git itself fails: that is no scan, not a clean commit.
    cat "$errors" >&2
    rm -f "$errors"
    echo "pre-commit: gitleaks reported an error, so nothing was scanned or committed" >&2
    exit 1
fi
rm -f "$errors"
if [ "$code" -ne 0 ]; then
    echo "pre-commit: gitleaks found a secret in what is staged (above, redacted); nothing was committed" >&2
fi
exit "$code"
